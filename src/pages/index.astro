---
import Sidebar from "../components/Sidebar.astro"
import Run from "../components/islands/Run.svelte"
import "../styles/tokens.css"

export const prerender = false
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CodeZard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gantari:wght@400;600;700&display=swap" rel="stylesheet" />
    <!--
      Runs before the sidebar paints, which is the whole point: read the stored state here
      and a collapsed sidebar is collapsed on the first frame instead of flashing open.
      `is:inline` keeps Astro from bundling it into a deferred module.
    -->
    <script is:inline>
      var stored = null
      try { stored = localStorage.getItem("cz:sidebar") } catch {}
      // No stored choice: start as the icon rail on a narrow screen, open on a wide one.
      // Deciding it here rather than in a media query keeps the toggle meaningful at every
      // width — CSS that forces the rail would ignore whatever the user picks.
      document.documentElement.dataset.sidebar =
        stored === "collapsed" || stored === "expanded"
          ? stored
          : matchMedia("(max-width: 860px)").matches
            ? "collapsed"
            : "expanded"

      // The chat column, for the same reason: it is rendered on the server as open, so
      // without this a hidden one appears and then vanishes on every load. The island keeps
      // both of these up to date once it hydrates.
      var chat = null
      var width = null
      try {
        chat = localStorage.getItem("cz:chat-open")
        width = Number(localStorage.getItem("cz:chat-width"))
      } catch {}
      document.documentElement.dataset.chat = chat === "no" ? "closed" : "open"
      if (Number.isFinite(width) && width >= 320) {
        document.documentElement.style.setProperty("--chat-w", Math.round(width) + "px")
      }
    </script>
  </head>
  <body>
    <div class="app">
      <Sidebar />
      <main>
        <!-- The only hydrated component on the page. It owns both the chat and the project
             panel because they read the same generated project: splitting them into two
             islands would mean two copies of that state and something to sync them. -->
        <Run client:load />
      </main>
    </div>
  </body>
</html>

<style>
  /* Fixed to the viewport, not `min-height`: the chat and the file tree each scroll
     inside their own pane, which only works if the shell itself does not grow. */
  .app { display: flex; height: 100vh; overflow: hidden; }
  main { flex: 1; min-width: 0; display: flex; }
  @media (max-width: 1100px) { .app { height: auto; min-height: 100vh; overflow: visible; } }
  @media (max-width: 860px) { main { margin-left: 68px; } }
</style>
