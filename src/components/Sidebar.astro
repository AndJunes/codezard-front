---
import Icon from "./Icon.astro"

/**
 * The navigation from the Elysium design: New Chat, Explore, Categories, Library,
 * Settings, the chat list, and the avatar/bell/theme row at the bottom.
 *
 * Labels are in Spanish because the rest of the interface is; the mockup is an English
 * comp, not a copy deck.
 */
const nav = [
  { label: "Explorar", icon: "search" },
  { label: "Categorías", icon: "grid" },
  { label: "Biblioteca", icon: "folder", count: 0 },
  { label: "Ajustes", icon: "settings" },
] as const

/**
 * Empty on purpose. The design shows a chat history, but nothing is persisted between
 * runs yet (TC-5/DR-4 forbid it in the MVP), so the section renders its empty state
 * rather than a list of invented conversations.
 */
const chats: { title: string; active: boolean }[] = []
---
<aside class="sidebar" id="sidebar">
  <div class="top">
    <div class="brand">
      <!-- `alt=""` because the name is right next to it: a screen reader announcing
           "CodeZard CodeZard" is worse than it announcing nothing here. It is also the
           whole brand when the sidebar is collapsed to the rail. -->
      <img class="mark" src="/mascota.svg" alt="" width="26" height="26" />
      <span class="brand__name">CodeZard</span>
    </div>
    <button class="toggle" id="sidebar-toggle" type="button" aria-controls="sidebar" aria-expanded="true">
      <Icon name="menu" size={18} />
      <span class="sr-only">Contraer o desplegar la barra lateral</span>
    </button>
  </div>

  <button class="new" type="button">
    <Icon name="plus" size={18} />
    <span class="label">Nuevo proyecto</span>
  </button>

  <nav aria-label="Principal">
    {nav.map((item) => (
      <button class="item" type="button" title={item.label}>
        <Icon name={item.icon} />
        <span class="label">{item.label}</span>
        {/* The comp shows a "141" pill. Shown only when there is something to count:
            a hard-coded number would be the interface telling its first lie. */}
        {"count" in item && item.count > 0 && <span class="count">{item.count}</span>}
      </button>
    ))}
  </nav>

  <section class="chats" aria-label="Proyectos">
    <h2>Proyectos</h2>
    {chats.length === 0 ? (
      <p class="empty">Todavía no hay ninguno. Los de esta sesión aparecen acá.</p>
    ) : (
      <ul>
        {chats.map((c) => (
          <li><button class:list={["chat", c.active && "chat--active"]} type="button">{c.title}</button></li>
        ))}
      </ul>
    )}
  </section>

  <footer class="bottom">
    <span class="avatar" aria-hidden="true">A</span>
    <span class="who label">
      <strong>Invitada</strong>
      <small>Sesión local</small>
    </span>
    <button class="ghost" type="button" title="Notificaciones">
      <Icon name="bell" size={18} /><span class="sr-only">Notificaciones</span>
    </button>
    <button class="ghost" type="button" title="Tema">
      <Icon name="sun" size={18} /><span class="sr-only">Cambiar el tema</span>
    </button>
  </footer>
</aside>

<script>
  /**
   * Collapse state lives on <html> rather than on the sidebar so the CSS can react before
   * this script runs — index.astro sets the same attribute inline in <head>, which is what
   * keeps a collapsed sidebar from flashing open on every page load.
   */
  const root = document.documentElement
  const toggle = document.getElementById("sidebar-toggle")

  toggle?.addEventListener("click", () => {
    const collapsed = root.dataset.sidebar !== "collapsed"
    root.dataset.sidebar = collapsed ? "collapsed" : "expanded"
    toggle.setAttribute("aria-expanded", String(!collapsed))
    // Wrapped: storage throws in private mode, and a thrown error here would leave the
    // sidebar working but the button dead for the rest of the session.
    try {
      localStorage.setItem("cz:sidebar", root.dataset.sidebar)
    } catch {}
  })

  toggle?.setAttribute("aria-expanded", String(root.dataset.sidebar !== "collapsed"))
</script>

<style>
  .sidebar {
    --w: 248px;
    width: var(--w);
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.1rem 0.85rem;
    background: var(--surface);
    border-right: 1px solid var(--line);
    transition: width 160ms ease;
  }
  @media (prefers-reduced-motion: reduce) { .sidebar { transition: none; } }

  .top { display: flex; align-items: center; gap: 0.5rem; padding: 0 0.25rem; }
  .brand { display: flex; align-items: center; gap: 0.55rem; font-weight: 700; font-size: 1.02rem; min-width: 0; }
  .mark { width: 26px; height: 26px; flex: none; display: block; }
  .brand__name { overflow: hidden; white-space: nowrap; }

  .toggle, .ghost {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 32px; height: 32px;
    flex: none;
    border: 0; border-radius: 9px;
    background: none; color: var(--text-dim);
  }
  .toggle:hover, .ghost:hover { background: var(--surface-2); color: var(--text); }
  .ghost { margin-left: 0; }

  .new {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.62rem 0.8rem;
    border: 0; border-radius: 12px;
    background: var(--accent); color: var(--accent-ink);
    font-weight: 600;
  }
  .new:hover { filter: brightness(1.06); }

  nav { display: flex; flex-direction: column; gap: 0.15rem; }
  .item {
    display: flex; align-items: center; gap: 0.7rem;
    width: 100%;
    padding: 0.58rem 0.8rem;
    border: 0; border-radius: 10px;
    background: none; color: var(--text-dim);
    text-align: left;
  }
  .item:hover { background: var(--surface-2); color: var(--text); }
  .count {
    margin-left: auto;
    font-size: 0.75rem; font-weight: 600;
    padding: 0.05rem 0.45rem; border-radius: 999px;
    background: var(--surface-2); color: var(--text-dim);
  }

  .chats { min-height: 0; overflow-y: auto; padding: 0 0.25rem; }
  .chats h2 { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-dim); }
  .chats ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  .empty { margin: 0; font-size: 0.8rem; color: var(--text-dim); line-height: 1.45; }
  .chat {
    width: 100%; text-align: left;
    padding: 0.45rem 0.55rem;
    border: 0; border-left: 2px solid transparent; border-radius: 8px;
    background: none; color: var(--text-dim);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .chat:hover { background: var(--surface-2); color: var(--text); }
  .chat--active { border-left-color: var(--accent); color: var(--text); background: var(--surface-2); }

  .bottom { margin-top: auto; display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.25rem 0; border-top: 1px solid var(--line); }
  .avatar { display: grid; place-items: center; width: 30px; height: 30px; flex: none; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-weight: 700; font-size: 0.82rem; }
  .who { display: flex; flex-direction: column; min-width: 0; line-height: 1.15; }
  .who strong { font-size: 0.85rem; font-weight: 600; }
  .who small { font-size: 0.72rem; color: var(--text-dim); }
  .who + .ghost { margin-left: auto; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* Collapsed: an icon rail. Labels are removed from the layout rather than hidden with
     opacity, so they stop taking width and stop being read aloud. */
  :global(:root[data-sidebar="collapsed"]) .sidebar { --w: 68px; padding-inline: 0.6rem; }
  :global(:root[data-sidebar="collapsed"]) .label,
  :global(:root[data-sidebar="collapsed"]) .brand__name,
  :global(:root[data-sidebar="collapsed"]) .count,
  :global(:root[data-sidebar="collapsed"]) .chats { display: none; }
  :global(:root[data-sidebar="collapsed"]) .top { flex-direction: column; gap: 0.6rem; padding: 0; }
  :global(:root[data-sidebar="collapsed"]) .toggle { margin-left: 0; }
  :global(:root[data-sidebar="collapsed"]) .new,
  :global(:root[data-sidebar="collapsed"]) .item { justify-content: center; padding-inline: 0; }
  :global(:root[data-sidebar="collapsed"]) .bottom { flex-direction: column; gap: 0.35rem; }
  :global(:root[data-sidebar="collapsed"]) .who + .ghost { margin-left: 0; }

  /* Narrow screens don't force the rail here — the inline script in <head> picks
     "collapsed" as the *default* when there is no stored preference. Forcing it in CSS
     made the toggle a dead button on a phone: the state changed and nothing moved.
     Expanded on a narrow screen floats over the content instead of squeezing it. */
  @media (max-width: 860px) {
    .sidebar { position: fixed; inset: 0 auto 0 0; z-index: 20; }
    :global(:root[data-sidebar="expanded"]) .sidebar { box-shadow: 0 0 0 100vmax rgb(0 0 0 / 0.5); }
  }
</style>
