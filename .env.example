# Where the CodeZard gateway lives. Inside Docker it is the service name; in local
# development, whatever host you are running it on.
GATEWAY_URL=http://gateway:8000

# The service name the gateway routes the backend agent under: /api/{name}/...
BACKEND_SERVICE=backend

# Shared secret with the backend agent. It is read on the server and attached to the
# outgoing request: it must never reach the browser.
MIRAG_TOKEN=
